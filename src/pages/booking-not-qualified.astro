---
export const prerender = true;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Your Call — Career Crossroads™</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --plum:     #2d1b3d;
      --plum-400: #7b5499;
      --gold:     #c9a227;
      --cream:    #fdf9f4;
    }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      background: #ffffff;
      color: var(--plum);
      min-height: 100vh;
    }

    .top-bar {
      background: #ffffff;
      padding: 16px 24px;
      text-align: center;
      border-bottom: 1px solid #ede0cc;
    }
    .top-bar__logo img {
      height: 48px;
      width: auto;
    }

    .hero {
      padding: 40px 24px 32px;
      text-align: center;
    }
    .approved-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #e8f5e9;
      border: 1.5px solid #a5d6a7;
      color: #2e7d32;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 5px 16px;
      border-radius: 100px;
      margin-bottom: 16px;
    }
    .approved-badge::before { content: '✓'; }
    .hero__step {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 10px;
    }
    .hero__headline {
      font-family: 'Playfair Display', serif;
      font-size: clamp(24px, 3.5vw, 38px);
      font-weight: 700;
      color: var(--plum);
      line-height: 1.25;
      max-width: 560px;
      margin: 0 auto 10px;
    }
    .hero__headline em { font-style: italic; color: var(--plum-400); }
    .hero__sub {
      color: var(--plum-400);
      font-size: 15px;
      max-width: 420px;
      margin: 0 auto;
    }

.session-card {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 24px 40px;
    }
    .session-card__title {
      font-family: 'Playfair Display', serif;
      font-size: 16px;
      font-weight: 600;
      color: var(--plum);
      margin-bottom: 8px;
    }
    .session-card__list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .session-card__list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 16px;
      font-weight: 700;
      color: #3d2552;
    }
    .session-card__list li::before {
      content: '✓';
      color: #a8803a;
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 2px;
    }

.calendar-wrap {
      max-width: 900px;
      margin: 28px auto 0;
      padding: 0 16px 48px;
    }
    .calendar-wrap iframe {
      width: 100%;
      border: none;
      display: block;
      border-radius: 12px;
      height: 760px;
    }
    @media (max-width: 640px) {
      .calendar-wrap iframe { height: 470px; }
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <div class="top-bar__logo"><img src="/images/logo-leading-edge.png" alt="The Leading Edge Life" /></div>
  </div>

  <section class="hero">
    <div class="approved-badge">Application Pre-Approved</div>
    <h1 class="hero__headline">Last Step. <em>Pick a time below.</em></h1>
    <p class="hero__sub">Your info is saved. Just pick a date and time that works for you.</p>
  </section>

  <div class="calendar-wrap">
    <iframe id="booking-iframe"
      src="https://link.msgsndr.com/widget/booking/Lz5sKToGtw1Lb4Rc6EXP"
      title="Book Your Discovery Call"
      scrolling="no">
    </iframe>
  </div>

  <div class="session-card">
    <p class="session-card__title">On your call, you'll discover:</p>
    <ul class="session-card__list">
      <li>What's really causing your dissatisfaction at work</li>
      <li>Whether you need a new job, a new career direction, or a different strategy altogether</li>
      <li>The most aligned opportunities available to you right now</li>
      <li>How the Career Crossroads™ Process helps professionals make confident career decisions and move forward with purpose</li>
    </ul>
  </div>

  <footer style="text-align:center; padding: 28px 24px; font-size:12px; color:#888; border-top:1px solid #ede0cc;">
    <a href="https://www.theleadingedge.life/pages/terms" target="_blank" style="color:#888; text-decoration:none; margin:0 12px;">Terms of Service</a>
    <a href="https://www.theleadingedge.life/pages/privacy-policy" target="_blank" style="color:#888; text-decoration:none; margin:0 12px;">Privacy Policy</a>
  </footer>

  <script is:inline>
    const p = new URLSearchParams(window.location.search);
    const iframe = document.getElementById('booking-iframe');
    const url = new URL(iframe.src);
    ['firstName','lastName','email','phone'].forEach(function(k) {
      const v = p.get(k);
      if (v) url.searchParams.set(k === 'firstName' ? 'first_name' : k === 'lastName' ? 'last_name' : k, v);
    });
    iframe.src = url.toString();
  </script>

</body>
</html>
