---
import Layout from "../layouts/Layout.astro";
import { BOOK_CALL_URL, SOCIAL } from "../lib/utils";
---

<Layout title="Connect | The Abundance Sisters">

  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden pt-20">
    <div class="absolute inset-0 hero-bg"></div>
    <div class="absolute top-1/3 right-1/3 w-72 h-72 rounded-full bg-rose-400/10 blur-3xl animate-float"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-6 inline-block">Let&apos;s Chat</span>
      <h1 class="section-heading mb-6">We&apos;d Love to <span class="gradient-text">Connect</span></h1>
      <p class="text-plum-600 text-lg max-w-2xl mx-auto">
        Share your story. Ask your questions. Take the first step toward your transformation. We&apos;re here and ready.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">

        <!-- Book A Call -->
        <div class="card border border-rose-200 p-8 md:p-10 h-full">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-rose-400/30 to-plum-600/30 flex items-center justify-center text-rose-500 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h2 class="font-serif text-3xl font-bold text-plum-900 mb-3">Let&apos;s Chat</h2>
          <p class="text-plum-600 leading-relaxed mb-4">
            Book a complimentary discovery call with the Sisters. Come ready for your session by being in a quiet, undistracted place.
          </p>
          <p class="text-plum-300 text-sm font-medium mb-8">
            No obligation. Just a real conversation about where you are and where you want to go.
          </p>
          <a href={BOOK_CALL_URL} target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex">
            Book Your Call
          </a>
        </div>

        <!-- Email Form -->
        <div class="card border border-plum-100 p-8 md:p-10 h-full">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-plum-600/20 to-rose-400/20 flex items-center justify-center text-plum-500 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h2 class="font-serif text-3xl font-bold text-plum-900 mb-3">Prefer Email?</h2>
          <p class="text-plum-600 leading-relaxed mb-2">Send us a message and we&apos;ll get back to you as soon as possible.</p>
          <p class="text-plum-300 text-xs mb-8">We do not respond to solicitations.</p>
          <form class="space-y-4" id="contact-form">
            <div class="grid grid-cols-2 gap-3">
              <input type="text" placeholder="First name" required class="field" />
              <input type="text" placeholder="Last name" class="field" />
            </div>
            <input type="email" placeholder="Email address" required class="field" />
            <textarea placeholder="What would you like to share or ask?" rows="4" class="field resize-none"></textarea>
            <button type="submit" class="btn-primary w-full">Send Message</button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- Social Media -->
  <section class="py-20 relative overflow-hidden section-alt">
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-4 inline-block">Find Us Online</span>
        <h2 class="section-heading">Follow Along the <span class="gradient-text">Journey</span></h2>
        <p class="text-plum-500 mt-4 max-w-lg mx-auto">
          When you follow, leave us a comment and we&apos;ll follow you back. Let&apos;s build community together.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">

        <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="card-hover border border-rose-200/50 p-6 text-center block">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-rose-400/20 to-plum-600/20 flex items-center justify-center text-plum-700 mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </div>
          <h3 class="font-semibold text-plum-900 mb-1">Instagram</h3>
          <p class="text-rose-400 text-sm font-medium mb-2">@the_abundance_sisters</p>
          <p class="text-plum-400 text-xs">Business coaching and tools</p>
        </a>

        <a href={SOCIAL.tiktok} target="_blank" rel="noopener noreferrer" class="card-hover border border-plum-200/50 p-6 text-center block">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-plum-500/20 to-rose-400/20 flex items-center justify-center text-plum-700 mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-plum-900 mb-1">TikTok</h3>
          <p class="text-rose-400 text-sm font-medium mb-2">@theabundancesisters</p>
          <p class="text-plum-400 text-xs">Manifestation tips</p>
        </a>

        <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="card-hover border border-gold-200/50 p-6 text-center block">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gold-500/20 to-plum-600/20 flex items-center justify-center text-plum-700 mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </div>
          <h3 class="font-semibold text-plum-900 mb-1">Facebook</h3>
          <p class="text-rose-400 text-sm font-medium mb-2">The Abundance Sisters</p>
          <p class="text-plum-400 text-xs">Spiritual inspiration</p>
        </a>

      </div>
    </div>
  </section>

</Layout>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Form submission — connect your email provider or CRM.");
  });
</script>
