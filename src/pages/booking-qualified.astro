---
export const prerender = true;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Your Call — Career Crossroads™</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --plum:     #2d1b3d;
      --plum-400: #7b5499;
      --gold:     #c9a227;
      --cream:    #fdf9f4;
    }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      background: #ffffff;
      color: var(--plum);
      min-height: 100vh;
    }

    .top-bar {
      background: #ffffff;
      padding: 16px 24px;
      text-align: center;
      border-bottom: 1px solid #ede0cc;
    }
    .top-bar__logo {
      font-family: 'Playfair Display', serif;
      font-size: 17px;
      font-weight: 700;
      color: var(--plum);
    }

    .hero {
      padding: 40px 24px 32px;
      text-align: center;
    }
    .approved-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #e8f5e9;
      border: 1.5px solid #a5d6a7;
      color: #2e7d32;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 5px 16px;
      border-radius: 100px;
      margin-bottom: 16px;
    }
    .approved-badge::before { content: '✓'; }
    .hero__step {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 10px;
    }
    .hero__headline {
      font-family: 'Playfair Display', serif;
      font-size: clamp(24px, 3.5vw, 38px);
      font-weight: 700;
      color: var(--plum);
      line-height: 1.25;
      max-width: 560px;
      margin: 0 auto 10px;
    }
    .hero__headline em { font-style: italic; color: var(--plum-400); }
    .hero__sub {
      color: var(--plum-400);
      font-size: 15px;
      max-width: 420px;
      margin: 0 auto;
    }

    .summary-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      justify-content: center;
      margin: 16px auto 0;
      font-size: 14px;
      color: var(--plum-400);
      max-width: 600px;
      padding: 0 24px;
    }
    .summary-strip span { display: flex; align-items: center; gap: 5px; }
    .summary-strip strong { color: var(--plum); font-weight: 600; }

    .calendar-wrap {
      max-width: 900px;
      margin: 28px auto 0;
      padding: 0 16px 48px;
    }
    .calendar-wrap iframe {
      width: 100%;
      border: none;
      display: block;
      border-radius: 12px;
      height: 900px;
    }
    @media (max-width: 640px) {
      .calendar-wrap iframe { height: 1100px; }
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <div class="top-bar__logo">Career Crossroads™</div>
  </div>

  <section class="hero">
    <div class="approved-badge">Application Pre-Approved</div>
    <h1 class="hero__headline">Last Step. <em>Choose a time below.</em></h1>
    <p class="hero__sub">Your info is saved. Just pick a date and time that works for you.</p>
  </section>

  <div class="summary-strip" id="summary-strip" style="display:none;">
    <span>👋 <strong id="s-name"></strong></span>
    <span>✉️ <strong id="s-email"></strong></span>
    <span>📞 <strong id="s-phone"></strong></span>
  </div>

  <div class="calendar-wrap">
    <iframe id="booking-iframe"
      src="https://link.msgsndr.com/widget/booking/Lz5sKToGtw1Lb4Rc6EXP"
      title="Book Your Discovery Call"
      scrolling="no">
    </iframe>
  </div>

  <script is:inline>
    const p = new URLSearchParams(window.location.search);
    const firstName = p.get('firstName') || '';
    const lastName  = p.get('lastName')  || '';
    const email     = p.get('email')     || '';
    const phone     = p.get('phone')     || '';

    if (firstName || email) {
      const strip = document.getElementById('summary-strip');
      strip.style.display = 'flex';
      document.getElementById('s-name').textContent  = [firstName, lastName].filter(Boolean).join(' ');
      document.getElementById('s-email').textContent = email;
      document.getElementById('s-phone').textContent = phone;

      const iframe = document.getElementById('booking-iframe');
      const url = new URL(iframe.src);
      if (firstName) url.searchParams.set('first_name', firstName);
      if (lastName)  url.searchParams.set('last_name',  lastName);
      if (email)     url.searchParams.set('email',      email);
      if (phone)     url.searchParams.set('phone',      phone);
      iframe.src = url.toString();
    }
  </script>

</body>
</html>
