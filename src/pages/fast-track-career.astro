  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1108765660134323&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --plum:     #2d1b3d;
      --plum-400: #7b5499;
      --gold:     #c9a227;
      --cream:    #fdf9f4;
    }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      background: #ffffff;
      color: var(--plum);
      min-height: 100vh;
    }

    .top-bar {
      background: #ffffff;
      padding: 16px 24px;
      text-align: center;
      border-bottom: 1px solid #ede0cc;
    }
    .top-bar__logo img {
      height: 48px;
      width: auto;
    }

    .hero {
      padding: 40px 24px 0;
      text-align: center;
    }
    .hero__headline {
      font-family: 'Playfair Display', serif;
      font-size: clamp(24px, 3.5vw, 38px);
      font-weight: 700;
      color: var(--plum);
      line-height: 1.3;
      max-width: 720px;
      margin: 0 auto;
    }
    .hero__headline .accent { color: var(--gold); }

    .video-section {
      max-width: 800px;
      margin: 32px auto 0;
      padding: 0 24px;
    }
    .video-wrap {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(45,27,61,0.12);
    }
    .video-wrap iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: 0;
    }

    .important-note {
      max-width: 640px;
      margin: 24px auto 0;
      padding: 0 24px 48px;
      text-align: center;
      font-style: italic;
      color: var(--plum-400);
      font-size: 15px;
    }

  </style>
</head>
<body>

  <div class="top-bar">
    <div class="top-bar__logo"><img src="/images/logo-leading-edge.png" alt="The Leading Edge Life" /></div>
  </div>

  <section class="hero">
    <h1 class="hero__headline">
      LAST STEP: Watch this video before we meet so we can hit the ground running for your <span class="accent">1:1 Career Planning Session</span>
    </h1>
  </section>

  <div class="video-section">
    <div class="video-wrap">
      <iframe src="https://www.youtube.com/embed/pf9er-f9tNA?rel=0&modestbranding=1" allowfullscreen title="Pre-Call Information"></iframe>
    </div>
  </div>

  <p class="important-note">
    IMPORTANT: Check your email and text for Zoom meeting link from The Abundance Sisters ✨
  </p>

  <footer style="text-align:center; padding: 28px 24px; font-size:12px; color:#888; border-top:1px solid #ede0cc;">
    <a href="https://www.theleadingedge.life/pages/terms" target="_blank" style="color:#888; text-decoration:none; margin:0 12px;">Terms of Service</a>
    <a href="https://www.theleadingedge.life/pages/privacy-policy" target="_blank" style="color:#888; text-decoration:none; margin:0 12px;">Privacy Policy</a>
  </footer>

</body>
</html>
