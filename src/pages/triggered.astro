---
import Layout from "../layouts/Layout.astro";

const TRIGGERED_URL = "https://www.theleadingedge.life/offers/GFj7NkCm";

const includes = [
  {
    tag: "Core Audio",
    title: "Press Play to Release the Trigger Pattern",
    desc: "A 7-minute guided audio that recalibrates your stored trigger response — feel different in minutes, without effort or analysis. A new automatic reaction replaces the old pattern. No managing, affirming, or 'working on it'.",
    value: "$197",
    iconBg: "from-rose-400/20 to-plum-600/20",
    iconColor: "text-rose-500",
    border: "border-rose-200",
  },
  {
    tag: "Included",
    title: "30 'Done For You' Statements",
    desc: "No guesswork. Just choose and press play. Targeted statements for Abundance, Self-Worth, and Relationships — pair with the 7-minute audio for deeper release.",
    value: "$97",
    iconBg: "from-plum-600/20 to-rose-400/20",
    iconColor: "text-plum-500",
    border: "border-plum-100",
  },
  {
    tag: "Bonus 1",
    title: "Three Advanced Guided Audios",
    desc: "Cellular Clearing and Inner Child Integration. Feel stable and OK regardless of circumstances. Release self-doubt and internal pressure. Feel safe being fully yourself.",
    value: "$297",
    iconBg: "from-gold-500/20 to-plum-600/20",
    iconColor: "text-gold-600",
    border: "border-gold-300",
  },
  {
    tag: "Bonus 2",
    title: "Release Anxiety Instantly",
    desc: "A Heart-Breath audio to regulate your nervous system for rapid calm. Learn a simple breath technique you can use anywhere, anytime.",
    value: "$97",
    iconBg: "from-rose-400/20 to-gold-500/20",
    iconColor: "text-rose-500",
    border: "border-rose-200",
  },
  {
    tag: "Bonus 3",
    title: "Receive Guidance From Your Future Self",
    desc: "A guided attunement to your highest timeline. Align with the frequency of your future self and release fear and self-doubt standing in the way.",
    value: "$97",
    iconBg: "from-plum-600/20 to-rose-400/20",
    iconColor: "text-plum-500",
    border: "border-plum-100",
  },
];

const testimonials = [
  {
    quote: "I don't have anxiety or feel like I'm reacting. Things that used to bother me just don't anymore. Thank you Julia and Claudia.",
    name: "Portia",
    role: "Entrepreneur",
  },
  {
    quote: "It feels more like a transmission than guided audio. Like they're pulling all the magic from the heavens and putting it into my cells. I am so grateful.",
    name: "Kristen",
    role: "Energy Healer",
  },
];
---

<Layout title="From Triggered To Calm™ | The Abundance Sisters">

  <!-- Hero -->
  <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden pt-20">
    <div class="absolute inset-0 hero-bg"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-rose-200/20 blur-3xl animate-float"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 rounded-full bg-plum-200/20 blur-3xl animate-float" style="animation-delay: 2s;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-6 inline-block animate-fade-up">
        ✦ Guided Audio Experience ✦
      </span>
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold text-plum-900 mb-6 leading-tight animate-fade-up [animation-delay:120ms]">
        From Triggered<br /><span class="gradient-text">To Calm™</span>
      </h1>
      <p class="text-xl text-plum-600 max-w-2xl mx-auto mb-4 animate-fade-up [animation-delay:240ms]">
        The Only 'Press Play' Path To Lasting Emotional Freedom
      </p>
      <p class="text-plum-500 max-w-xl mx-auto mb-10 animate-fade-up [animation-delay:300ms]">
        The exact guided shifts designed to release emotional triggers at their root — once and for all. All you do is press play.
      </p>
      <div class="animate-fade-up [animation-delay:360ms]">
        <a href={TRIGGERED_URL} target="_blank" rel="noopener noreferrer" class="btn-primary text-lg px-10 py-4">
          Yes! I want to just press play
        </a>
        <p class="text-plum-400 text-sm mt-4">Total value $785 — yours today for just <strong class="text-plum-700">$97</strong></p>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <span class="tag bg-plum-100 border border-plum-200 text-plum-600 mb-6 inline-block">Sound Familiar?</span>
      <h2 class="section-heading mb-8">
        Still Triggered Even After<br /><span class="gradient-text">All That Inner Work?</span>
      </h2>
      <p class="text-plum-600 leading-relaxed text-lg mb-6">
        We spent years trying to figure it all out ourselves — investing time, money, and effort… and still feeling stuck in certain triggers and the harsh inner voice that followed.
      </p>
      <p class="text-plum-600 leading-relaxed text-lg mb-6">
        There's nothing wrong with you. That emotional reaction and the inner critic both arise from the same deeper nervous-system pattern — not from a lack of insight or growth.
      </p>
      <p class="font-serif text-2xl font-bold text-plum-900 mt-10">
        You really can shift from triggered to calm — and into inner safety — <span class="gradient-text">in minutes.</span>
      </p>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 md:py-28 section-alt">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="tag bg-gold-100 border border-gold-300 text-gold-600 mb-6 inline-block">How It Works</span>
      <h2 class="section-heading mb-4">
        Press Play. Release The Trigger.<br /><span class="gradient-text-gold">Program A New Response.</span>
      </h2>
      <p class="text-plum-500 max-w-xl mx-auto mb-16">
        Do you want our guided audios proven to dissolve emotional triggers so calm becomes automatic?
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { step: "01", title: "Press Play", desc: "Just hit play — no preparation, analysis, or effort required." },
          { step: "02", title: "Release the Trigger", desc: "The audio recalibrates your stored trigger response at the root." },
          { step: "03", title: "Program a New Response", desc: "A new automatic calm reaction replaces the old pattern — for good." },
        ].map((s) => (
          <div class="card p-8 text-center">
            <div class="font-serif text-5xl font-bold gradient-text-gold mb-4">{s.step}</div>
            <h3 class="font-semibold text-plum-900 text-lg mb-3">{s.title}</h3>
            <p class="text-plum-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-4 inline-block">Everything Included</span>
        <h2 class="section-heading">
          Here's Everything You Receive in<br /><span class="gradient-text">From Triggered To Calm™</span>
        </h2>
      </div>
      <div class="space-y-4">
        {includes.map((item) => (
          <div class={`card border ${item.border} p-6 md:p-8 flex flex-col sm:flex-row sm:items-start gap-5`}>
            <div class={`w-12 h-12 shrink-0 rounded-xl bg-gradient-to-br ${item.iconBg} flex items-center justify-center ${item.iconColor}`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <span class="text-xs font-semibold tracking-widest uppercase text-plum-300">{item.tag}</span>
                <span class="text-xs font-semibold text-gold-600 bg-gold-100 border border-gold-200 px-2 py-0.5 rounded-full">Value: {item.value}</span>
              </div>
              <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">{item.title}</h3>
              <p class="text-plum-600 leading-relaxed text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 md:py-28 section-alt relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle, #ddc9ec 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4">
      <div class="text-center mb-14">
        <span class="tag bg-plum-100 border border-plum-200 text-plum-600 mb-4 inline-block">Client Experiences</span>
        <h2 class="section-heading">
          What Clients Experience After<br /><span class="gradient-text">From Triggered To Calm™</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <div class="card p-8 md:p-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-gold-500 mb-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            <blockquote class="font-serif text-xl font-bold text-plum-900 leading-snug mb-8">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <div class="divider-glow mb-6"></div>
            <cite class="not-italic">
              <div class="font-semibold text-plum-800">{t.name}</div>
              <div class="text-plum-400 text-sm">{t.role}</div>
            </cite>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing & CTA -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="relative card border-gold-200 shadow-md p-10 md:p-14 overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-400 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-gold-100/50 to-transparent rounded-2xl"></div>
        <div class="relative z-10">
          <span class="tag bg-gold-100 border border-gold-300 text-gold-600 mb-6 inline-block">✦ Special Offer ✦</span>
          <h2 class="font-serif text-3xl font-bold text-plum-900 mb-3">Get Instant Access Today</h2>
          <div class="flex items-center justify-center gap-4 my-6">
            <span class="text-plum-300 text-xl line-through">$785 value</span>
            <span class="font-serif text-5xl font-bold gradient-text-gold">$97</span>
          </div>
          <p class="text-plum-500 mb-8">One-time investment. Lifetime access. Press play as often as you need.</p>
          <a href={TRIGGERED_URL} target="_blank" rel="noopener noreferrer" class="btn-gold inline-flex text-lg px-10 py-4 mb-8">
            Yes! I want to just press play
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </a>
          <div class="border-t border-gold-200 pt-6 mt-2">
            <p class="text-plum-500 text-sm font-medium mb-1">100% Money Back Guaranteed</p>
            <p class="text-plum-400 text-xs leading-relaxed">
              If you listen to the guided audios and don't notice your trigger patterns changing within 30 days, we will refund your money. No questions asked.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-8 text-plum-400 text-sm italic">Wrapping You In Love — Julia &amp; Claudia</p>
    </div>
  </section>

</Layout>
