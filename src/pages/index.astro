---
import Layout from "../layouts/Layout.astro";
import { BOOK_CALL_URL } from "../lib/utils";
---

<Layout title="The Abundance Sisters | The Leading Edge Life">

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/sisters.jpg"
        alt="The Abundance Sisters — Claudia and Julia"
        class="w-full h-full object-cover object-top"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/65 to-white/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-cream-50/50 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20">
      <div class="max-w-2xl">
        <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-6 inline-block animate-fade-up">
          ✦ The Abundance Sisters ✦
        </span>
        <h1 class="section-heading mb-6 animate-fade-up [animation-delay:120ms]">
          Remember the truth{" "}
          <span class="gradient-text">of who you are</span>
        </h1>
        <p class="text-lg text-plum-600 max-w-xl mb-10 leading-relaxed animate-fade-up [animation-delay:240ms]">
          Activate your abundant codes. Step into your true power — aligned,
          confident, and purpose-driven. Divine guidance for spiritual
          liberation of mind, body, and soul.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 animate-fade-up [animation-delay:360ms]">
          <a href={BOOK_CALL_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Book A Call Now
          </a>
          <a href="/about" class="btn-outline">
            Meet the Sisters
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="mt-14 flex flex-wrap gap-8 text-plum-400 text-sm animate-fade-up [animation-delay:480ms]">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a96e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            20+ Years Experience
          </span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a96e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Thousands of Clients
          </span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a96e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Multiple Modalities
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="tag bg-plum-100 border border-plum-200 text-plum-600 mb-6 inline-block">About Us</span>
          <h2 class="section-heading mb-6">
            It&apos;s A <span class="gradient-text">Family Affair</span>
          </h2>
          <p class="text-plum-600 leading-relaxed mb-5">
            We are teachers and channels here to serve humanity through
            divine guidance to spiritual liberation of mind, body, and soul.
            As actual sisters, we bring a combined 20 years of experience as
            behavioral science specialists and business consultants.
          </p>
          <p class="text-plum-600 leading-relaxed mb-8">
            We help leaders, entrepreneurs, and changemakers step into their
            true power — aligned, confident, and purpose-driven.
          </p>
          <a href="/about" class="btn-outline inline-flex">
            Our Story
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden aspect-[4/5] shadow-xl shadow-plum-100">
            <img
              src="/images/sisters.jpg"
              alt="Claudia and Julia — The Abundance Sisters"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-5 -left-5 bg-white rounded-2xl shadow-lg p-5 border border-plum-100">
            <div class="text-2xl font-serif font-bold gradient-text-gold">20+</div>
            <div class="text-plum-400 text-xs mt-0.5">Years of Experience</div>
          </div>
          <div class="absolute -top-5 -right-5 bg-white rounded-2xl shadow-lg p-5 border border-plum-100">
            <div class="text-2xl font-serif font-bold gradient-text">1000s</div>
            <div class="text-plum-400 text-xs mt-0.5">Lives Transformed</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="py-24 md:py-32 section-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="tag bg-rose-100 border border-rose-200 text-rose-600 mb-4 inline-block">Our Offerings</span>
        <h2 class="section-heading mb-4">
          Your Path to <span class="gradient-text">Divine Alignment</span>
        </h2>
        <p class="text-plum-500 max-w-xl mx-auto">
          Every offering is designed to meet you exactly where you are on your transformation journey.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

        <a href="/sessions" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-rose-100 text-rose-500 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Personalized Transformation</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">1:1 Sessions</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Deeply personal one-on-one energy sessions, mentoring, and behavioral coaching tailored to your unique soul blueprint.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Check Out Sessions <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

        <a href="/courses" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-plum-100 text-plum-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Self-Paced Mastery</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">Digital Courses</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Master your mind, align with your strengths, and lead from the heart with our transformational digital course library.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Check Out Courses <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

        <a href="/memberships" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-gold-100 text-gold-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Ongoing Divine Support</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">Memberships</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Join a sacred community with weekly circles, private sessions, and continuous energetic support on your journey.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Become a Member <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

        <a href="/programs" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-plum-100 text-plum-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Deep Immersion</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">Programs</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Comprehensive transformation programs combining ancient wisdom with modern science for lasting, profound change.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Check Out Programs <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

        <a href="/workshops" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-rose-100 text-rose-500 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Live Group Experiences</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">Workshops</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Immersive group workshops designed to activate, align, and elevate your energy in a powerful collective field.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Check Out Workshops <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

        <a href="/gifts" class="block card-hover p-8 h-full group">
          <div class="w-11 h-11 rounded-xl bg-gold-100 text-gold-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </div>
          <div class="text-xs font-semibold tracking-widest uppercase text-plum-300 mb-2">Start Here</div>
          <h3 class="font-serif text-xl font-bold text-plum-900 mb-3">Free Gifts</h3>
          <p class="text-plum-500 text-sm leading-relaxed mb-6">Access our sacred free offerings — weekly group clearings, the Inner Critic guide, and the Life Wheel Assessment.</p>
          <span class="flex items-center gap-2 text-rose-500 text-sm font-medium group-hover:gap-3 transition-all">
            Claim Your Gifts <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- COMMUNITY PHOTOS -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="tag bg-gold-100 border border-gold-300 text-gold-600 mb-4 inline-block">Our Community</span>
        <h2 class="section-heading">
          Transformation <span class="gradient-text">In Action</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="relative aspect-[4/3] rounded-3xl overflow-hidden shadow-lg">
          <img src="/images/workshop-dome.jpg" alt="Sacred circle workshop in geodesic dome" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-plum-900/50 to-transparent"></div>
          <div class="absolute bottom-5 left-5 text-white">
            <div class="font-serif text-lg font-semibold">Sacred Circles</div>
            <div class="text-white/70 text-sm">Live workshop experiences</div>
          </div>
        </div>
        <div class="relative aspect-[4/3] rounded-3xl overflow-hidden shadow-lg">
          <img src="/images/workshop-group.jpg" alt="Group transformation workshop" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-plum-900/50 to-transparent"></div>
          <div class="absolute bottom-5 left-5 text-white">
            <div class="font-serif text-lg font-semibold">Group Transformation</div>
            <div class="text-white/70 text-sm">More powerful together</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="py-24 md:py-32 section-alt relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle, #ddc9ec 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <div class="card p-12 md:p-16 shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gold-500 mx-auto mb-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <blockquote class="font-serif text-2xl md:text-3xl font-bold text-plum-900 leading-tight mb-8">
          &ldquo;I went from the doctors telling me I needed a liver transplant, to riding horses in 6 months.&rdquo;
        </blockquote>
        <div class="divider-glow mb-6"></div>
        <cite class="not-italic">
          <div class="font-semibold text-plum-800">Julia</div>
          <div class="text-plum-400 text-sm">Client Transformation</div>
        </cite>
      </div>
    </div>
  </section>

  <!-- FREE GIFTS CTA -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative card border-gold-200 shadow-md p-12 md:p-16 text-center overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-400 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-gold-100/60 to-transparent rounded-2xl"></div>
        <div class="relative z-10">
          <span class="tag bg-gold-100 border border-gold-300 text-gold-600 mb-6 inline-block">✦ Free Access ✦</span>
          <h2 class="section-heading mb-4">
            Our <span class="gradient-text-gold">Gifts For You</span>
          </h2>
          <p class="text-plum-500 max-w-xl mx-auto mb-10">
            Free access to our sacred circle and downloads for your abundance. Start your transformation today — no investment required.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/gifts" class="btn-gold">
              Claim Your Free Gifts
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </a>
            <a href={BOOK_CALL_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">
              Book Your Call Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
