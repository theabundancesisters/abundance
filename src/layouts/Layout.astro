---
import "../styles/global.css";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Abundance Sisters | The Leading Edge Life",
  description = "Spiritual liberation of mind, body, and soul. Transform your life with The Abundance Sisters — energy clearing, divine guidance, and soul alignment.",
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="abundance sisters, spiritual coaching, energy clearing, soul alignment, leading edge life, brain shift, divine guidance, transformation" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.theleadingedge.life" />
    <meta property="og:site_name" content="The Leading Edge Life" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --font-inter: "Inter", system-ui, sans-serif;
        --font-playfair: "Playfair Display", Georgia, serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-cream-50 text-plum-900 antialiased">
    <Navbar client:load pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
